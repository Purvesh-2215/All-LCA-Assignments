# Student Data Management Using Dictionary, Tuple, and List

# Tuple: stores the attributes of a student
student1 = (101, "Rahul", "Computer Engineering", 85)
student2 = (102, "Priya", "Information Technology", 90)
student3 = (103, "Amit", "Mechanical Engineering", 78)

# List: stores multiple student tuples
students_list = [student1, student2, student3]

# Dictionary: stores student records using Roll Number as the key
students = {
    student[0]: student[1:]
    for student in students_list
}

print("Original Student Records:")
print(students)


# 1. Add a new student record
new_student = (104, "Sneha", "Electronics", 88)
students[new_student[0]] = new_student[1:]

print("\nAfter Adding New Student:")
print(students)


# 2. Delete an existing student record
del students[102]

print("\nAfter Deleting Student with Roll Number 102:")
print(students)


# 3. Update details of a student
students[103] = ("Amit", "Mechanical Engineering", 85)

print("\nAfter Updating Student with Roll Number 103:")
print(students)


# 4. Display final student records
print("\nFinal Student Records:")

for roll_no, details in students.items():
    name, branch, marks = details

    print("Roll Number:", roll_no)
    print("Name:", name)
    print("Branch:", branch)
    print("Marks:", marks)
    print("----------------------")
